{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "mergeConfidence:all-badges",
    "security:minimumReleaseAgeNpm",
    "security:minimumReleaseAgeCrate",
    ":prHourlyLimitNone"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major update"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "addLabels": [
        "minor update"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "addLabels": [
        "patch update"
      ]
    },
    {
      "matchUpdateTypes": [
        "digest"
      ],
      "addLabels": [
        "digest update"
      ]
    },
    {
      "matchDatasources": ["npm"],
      "matchSourceUrls": [
        "https://github.com/angular/angular",
        "https://github.com/angular/angular-cli"
      ],
      "groupName": "angular monorepo",
      "commitMessageExtra": "{{#each upgrades}}{{#if (equals depName '@angular/core')}}to {{{prettyNewVersion}}}{{/if}}{{/each}}",
      "postUpgradeTasks": {
        "commands": [
          "{{#if (or (equals packageName '@angular/core') (equals packageName '@angular/cli'))}}cd ./ui && npx ng update {{{depName}}} --from={{{currentVersion}}} --to={{{newVersion}}} --migrate-only --allow-dirty --force{{/if}}"
        ]
      }
    },
    {
      "groupName": "debian images",
      "matchPackageNames": [
        "docker.io/debian",
        "docker.io/arm64v8/debian"
      ],
      "commitMessageExtra": "{{#each (distinct (lookupArray upgrades 'newVersion'))}}{{#if @first}}to {{else}}, {{/if}}{{{this}}}{{/each}}"
    },
    {
      "groupName": "opentelemetry monorepo",
      "matchSourceUrls": [
        "https://github.com/open-telemetry/opentelemetry-rust",
        "https://github.com/tokio-rs/tracing-opentelemetry"
      ],
      "commitMessageExtra": "{{#each upgrades}}{{#if (equals depName 'opentelemetry')}}to {{{prettyNewVersion}}}{{/if}}{{/each}}"
    },
    {
      "matchJsonata": [
        "sourceUrl in ['https://github.com/microsoft/playwright', 'https://github.com/vitest-dev/vitest']",
        "packageName in ['registry.kirauks.net/dev-ops/build-images/node', 'dev-ops/components/node']"
      ],
      "groupName": "test environment",
      "separateMinorPatch": false,
      "commitMessageExtra": "{{#each upgrades}}{{#if (equals depName 'playwright')}}(playwright {{{prettyNewVersion}}}){{/if}}{{/each}}"
    },
    {
      "groupName": "utoipa monorepo",
      "matchPackageNames": [
        "utoipa",
        "utoipa-swagger-ui"
      ],
      "commitMessageExtra": "{{#each upgrades}}{{#if (equals depName 'utoipa')}}to {{{prettyNewVersion}}}{{/if}}{{/each}}"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "bump"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "addLabels": [
        "docker"
      ],
      "minimumReleaseAge": "1 day",
      "pinDigests": true
    },
    {
      "matchCategories": [
        "rust"
      ],
      "addLabels": [
        "rust"
      ]
    },
    {
      "matchCategories": [
        "js"
      ],
      "addLabels": [
        "typescript"
      ]
    },
    {
      "matchCategories": [
        "ci"
      ],
      "addLabels": [
        "pipeline"
      ]
    },
    {
      "matchSourceUrls": [
        "https://gitlab.kirauks.net/**"
      ],
      "extends": [
        ":automergeStableNonMajor"
      ]
    },
    {
      "matchCategories": [
        "rust",
        "js"
      ],
      "extends": [
        ":automergePatch"
      ]
    }
  ]
}
